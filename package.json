{
  "name": "grow-with-code-v6",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-config.mjs && node scripts/copy-dist.mjs",
    "dev": "node scripts/build-config.mjs && npx serve . -l 5173",
