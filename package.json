    "security:audit": "node scripts/security-audit.mjs",
    "check": "npm run typecheck && npm run smoke && npm run security:audit"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "serve": "^14.2.4"
  }
}